# --- Backend ---
# true = pakai data contoh (tanpa Jira). Ubah ke false untuk memakai Jira Cloud.
JIRA_MOCK=true
JIRA_BASE_URL=https://perusahaan.atlassian.net
JIRA_EMAIL=nama@perusahaan.com
JIRA_API_TOKEN=isi-api-token
# ID field Story Points berbeda per site Jira (cek lewat /rest/api/3/field)
JIRA_STORY_POINTS_FIELD=customfield_10016
CORS_ORIGINS=["http://localhost:5173"]
STORAGE_DIR=storage
DATABASE_URL=postgresql+psycopg://timesheet:timesheet@db:5432/timesheet
REDIS_URL=redis://redis:6379/0

# --- Port Kustom Docker Host (untuk akses Postgres & Redis dari mesin host) ---
POSTGRES_PORT=5433
REDIS_PORT=6380
